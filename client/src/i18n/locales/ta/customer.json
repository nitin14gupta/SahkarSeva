    "customerFaq2A": "ஒவ்வொரு தொழிலாளியும் தங்கள் சுயவிவரத்தில் காட்டப்பட்டுள்ள தங்கள் சொந்த விலை வரம்பை அமைக்கின்றனர். நீங்கள் செலுத்துவதற்கு முன்பு இறுதி தொகை உறுதிப்படுத்தப்படுகிறது.",
    "customerFaq3Q": "நான் ரத்து செய்ய வேண்டியிருந்தால் என்ன செய்வது?",
    "customerFaq3A": "முன்பதிவுகள்> வரவிருக்கும் இடத்திலிருந்து முன்பதிவைத் திறந்து, ரத்துசெய்யவும் என்பதைத் தட்டவும். ஸ்லாட்டுக்கு ஒரு மணி நேரத்திற்கு முன்பு ரத்துசெய்தால் ஒரு பகுதி கட்டணம் வசூலிக்கப்படலாம்.",
    "customerFaq4Q": "பணத்தைத் திரும்பப் பெறுவது எப்படி வேலை செய்கிறது?",
    "customerFaq4A": "ரத்து செய்யப்பட்ட அல்லது சர்ச்சைக்குரிய முன்பதிவுகளுக்கான பணத்தைத் திரும்பப் பெறுவது 5 முதல் 7 வணிக நாட்களுக்குள் உங்கள் அசல் கட்டண முறைக்கு செயலாக்கப்படும்.",
    "customerFaq5Q": "தொழிலாளர்கள் சரிபார்க்கப்படுகிறார்களா?",
    "customerFaq5A": "சகார் சேவாவில் உள்ள ஒவ்வொரு தொழிலாளியும் முன்பதிவுகளை ஏற்றுக்கொள்வதற்கு முன்பு அவர்களின் கூட்டுறவு சங்கம் மூலம் சரிபார்க்கப்படுகிறார்கள்.",
    "workerFaq1Q": "நான் எப்படி சரிபார்க்கப்படுவது?",
    "workerFaq1A": "உங்கள் சுயவிவரத்தின் கீழ் பதிவு செய்யுங்கள்-தனிப்பட்ட விவரங்கள், கூட்டுறவு மற்றும் திறன்கள், பின்னர் உங்கள் அடையாள அட்டை மற்றும் திறன் சான்றிதழ்களைப் பதிவேற்றவும். 1 முதல் 2 வேலை நாட்களுக்குள் சமர்ப்பிப்புகளை உங்கள் கூட்டுறவு மதிப்பாய்வு செய்கிறது.",
    "workerFaq2Q": "எனது சரிபார்ப்பு ஏன் நிராகரிக்கப்பட்டது?",
    "workerFaq2A": "உங்கள் சரிபார்ப்பு நிலைத் திரையில் காட்டப்பட்டுள்ள காரணத்தை சரிபார்க்கவும்-வழக்கமாக படிக்க முடியாத புகைப்படம் அல்லது காணாமல் போன ஆவணம்-பின்னர் அதே திரையில் இருந்து மீண்டும் சமர்ப்பிக்கவும்.",
    "workerFaq3Q": "நான் எப்படி வேலைகளைப் பெறுவது?",
    "workerFaq3A": "சரிபார்க்கப்பட்டவுடன், முகப்பு தாவலில் இருந்து ஆன்லைனில் மாறவும், கிடைக்கும் தன்மையை நிர்வகிக்கவும் கீழ் உங்கள் கிடைக்கும் தன்மையை புதுப்பித்த நிலையில் வைத்திருக்கவும்.",
    "workerFaq4Q": "எனக்கு எப்போது சம்பளம் கிடைக்கும்?",
    "workerFaq4A": "தினசரி, வாராந்திர அல்லது மாதாந்திர வருவாய்> பணம் செலுத்துதல் மற்றும் வங்கி விவரங்களின் கீழ் நீங்கள் தேர்ந்தெடுக்கும் அட்டவணையைப் பின்பற்றுங்கள்.",
    "workerFaq5Q": "கூட்டுறவுக் கட்டணம் எவ்வாறு செயல்படுகிறது?",
    "workerFaq5A": "உங்கள் கூட்டுறவு நிறுவனம் முடிக்கப்பட்ட ஒவ்வொரு வேலையிலும் ஒரு சிறிய சதவீதத்தை வைத்திருக்கிறது (உங்கள் வருவாய் திரையில் காட்டப்பட்டுள்ளது)-மீதமுள்ளவை உங்களுடையவை."
  },
